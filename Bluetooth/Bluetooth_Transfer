//Ensure that you have PSRAM enabled
//Make sure that you have the SD and SPI libraries for the ESP32 installed
//The bluetooth library for the ESP32 should already be preinstalled but here is the github link incase:
// https://github.com/nkolban/ESP32_BLE_Arduino


#include <BLEDevice.h>
#include <BLEUtils.h>
#include <BLEServer.h>
#include <SD.h>
#include <SPI.h>

#define SD_CS_PIN 4       // Adjust based on your board
#define CHUNK_SIZE 512     // Size of each data chunk to send over BLE

BLEServer *pServer = NULL;
BLECharacteristic *pCharacteristic = NULL;
bool deviceConnected = false;

// BLE Server Callbacks
class MyServerCallbacks : public BLEServerCallbacks {
    void onConnect(BLEServer* pServer) {
        deviceConnected = true;
        Serial.println("Device connected.");
    }

    void onDisconnect(BLEServer* pServer) {
        deviceConnected = false;
        Serial.println("Device disconnected. Restarting advertising...");
        BLEDevice::startAdvertising(); // Restart advertising after disconnect
    }
};

void setup(){
    Serial.begin(115200);
    while(!Serial);
    if(!SD.begin(21)){
        Serial.println("Card Mount Failed");
        return;
    }
    uint8_t cardType = SD.cardType();

    if(cardType == CARD_NONE){
        Serial.println("No SD card attached");
        return;
    }

    Serial.print("SD Card Type: ");
    if(cardType == CARD_MMC){
        Serial.println("MMC");
    } else if(cardType == CARD_SD){
        Serial.println("SDSC");
    } else if(cardType == CARD_SDHC){
        Serial.println("SDHC");
    } else {
        Serial.println("UNKNOWN");
    }

    uint64_t cardSize = SD.cardSize() / (1024 * 1024);
    Serial.printf("SD Card Size: %lluMB\n", cardSize);


    // Initialize BLE
    BLEDevice::init("ESP32S3_Audio_Transfer");
    pServer = BLEDevice::createServer();
    pServer->setCallbacks(new MyServerCallbacks());

    // Create BLE Service and Characteristic
    BLEService *pService = pServer->createService(BLEUUID((uint16_t)0x180D));
    pCharacteristic = pService->createCharacteristic(
        BLEUUID((uint16_t)0x2A37),
        BLECharacteristic::PROPERTY_READ |
        BLECharacteristic::PROPERTY_NOTIFY
    );

    pService->start();

    // Start BLE Advertising
    BLEAdvertising *pAdvertising = BLEDevice::getAdvertising();
    pAdvertising->addServiceUUID(pService->getUUID());
    pAdvertising->start();

    Serial.println("Bluetooth device is ready to pair.");
}

void loop() {
    if (deviceConnected) {
        // Open audio file on SD card
        File audioFile = SD.open("/audio/sample.wav");
        if (!audioFile) {
            Serial.println("Failed to open file");
            return;
        }
        Serial.println("Sending file...");

        uint8_t buffer[CHUNK_SIZE];
        size_t bytesRead;

        // Read and send file in chunks over BLE
        while ((bytesRead = audioFile.read(buffer, sizeof(buffer))) > 0) {
            pCharacteristic->setValue(buffer, bytesRead);
            pCharacteristic->notify();  // Send the chunk over BLE
            delay(20);  // Small delay to prevent BLE buffer overflow
        }

        audioFile.close();
        Serial.println("File transfer complete.");
    }

    delay(1000); // Wait before checking again
}

