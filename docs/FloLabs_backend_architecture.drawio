        </mxCell>
        <mxCell id="sWMrG-oBjCXaMOg95JJ6-106" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontSize=10;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font&gt;Capability Layer Responsibilities&lt;/font&gt;&lt;/h1&gt;&lt;div&gt;&lt;b&gt;Agentic Core&lt;/b&gt;: Provide Agentic workflow structure, revised task workflow and run the workflow.&lt;/div&gt;&lt;div&gt;&lt;b&gt;LLM Routes&lt;/b&gt;: LLM Routing, AI Model usage Tracking.&lt;/div&gt;&lt;div&gt;&lt;b&gt;Workflow Engine: &lt;/b&gt;Cooperate with Agentic Core, record state, handle retry&amp;amp;backoff, concurrent, long task scheduling, cross-service arrangement, status &amp;amp; logs, durable execution.&lt;/div&gt;&lt;div&gt;&lt;b&gt;Search &amp;amp; VectorDB:&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;Interface to search through stores&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;b&gt;Data Processing Engine: &lt;/b&gt;Do analytics and train model&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;b&gt;File/Object Processing Gateway: &lt;/b&gt;pre-validation, staging storage, &lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;encrypt storage&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;b&gt;Cache: &lt;/b&gt;cache usually accessed info&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;b&gt;Queue/Event Bus: &lt;/b&gt;Driven by events, improve scalability&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Access Control Module&lt;/b&gt;: Validate CRUD Permission to info from store&lt;/div&gt;&lt;b&gt;External API Proxy&lt;/b&gt;: Provide unified proxy to all external API&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="265" width="400" x="890" y="557.5" as="geometry" />
        </mxCell>
        <mxCell id="sWMrG-oBjCXaMOg95JJ6-107" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontSize=10;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font&gt;Mid-Tier Backend Layer Responsibilities&lt;/font&gt;&lt;/h1&gt;&lt;div&gt;&lt;b&gt;User&amp;amp;Profile Service&lt;/b&gt;: Handle accounts&lt;/div&gt;&lt;div&gt;&lt;b&gt;Travel Planner&amp;nbsp;&lt;/b&gt;&lt;b&gt;Service&lt;/b&gt;&lt;b&gt;:&amp;nbsp;&lt;/b&gt;Provide AI Travel Planner related Policy, business logic and model; link frontend and platform.&lt;/div&gt;&lt;div&gt;&lt;b&gt;CAIPO&amp;nbsp;&lt;/b&gt;&lt;b&gt;Service&lt;/b&gt;&lt;b&gt;:&amp;nbsp;&lt;/b&gt;Provide CAIPO related Policy, business logic and model; link frontend and platform.&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;b&gt;Other &lt;/b&gt;&lt;/span&gt;&lt;b&gt;Services&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;b&gt;Placeholder: &lt;/b&gt;For future&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
