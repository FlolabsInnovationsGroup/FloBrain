        <mxCell id="sWMrG-oBjCXaMOg95JJ6-94" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontSize=10;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font&gt;Domain/Layer Responsibilities&lt;/font&gt;&lt;/h1&gt;&lt;div&gt;&lt;b&gt;API Gateway&lt;/b&gt;:&amp;nbsp;Provide a single endpoint to internet, Handles JWT, Auth, Routing, LB&lt;/div&gt;&lt;div&gt;&lt;b&gt;Control Plane&lt;/b&gt;: Provide interceptors to many modules, ensure Security, Activity Tracable, Easy Config&amp;amp;Debug, follow Policy and Easy Deployment&lt;/div&gt;&lt;div&gt;&lt;b&gt;Mid-Tier Backend Layer:&amp;nbsp;&lt;/b&gt;Provide Business Logic, Model and Adapters for each Domain&lt;/div&gt;&lt;div&gt;&lt;b&gt;Capability Layer:&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;A set of Ability modules, Actually do the thing.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;b&gt;Unified Storage: &lt;/b&gt;Store all info.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="132.5" width="440" x="-730" y="452" as="geometry" />
        </mxCell>
