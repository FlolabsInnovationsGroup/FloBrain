        <mxCell id="sWMrG-oBjCXaMOg95JJ6-108" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontSize=10;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font&gt;Control Plan Responsibilities&lt;/font&gt;&lt;/h1&gt;&lt;div&gt;&lt;b&gt;Config Service&lt;/b&gt;: Manage Version Control; Record all setting and deploying config for modules&lt;/div&gt;&lt;div&gt;&lt;b&gt;Monitor:&amp;nbsp;&lt;/b&gt;Provide Dashboard for monitor system metrics.&lt;/div&gt;&lt;div&gt;&lt;b&gt;Logging/Tracing:&amp;nbsp;&lt;/b&gt;Monitor detailed activities and events&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;b&gt;Secret Manager: &lt;/b&gt;Manage Secret Keys&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;b&gt;IAM: &lt;/b&gt;Check Identity and token&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;b&gt;Service Discovery: &lt;/b&gt;Allow Modules to call each other&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;b&gt;Rate Limit&amp;amp;Quota Service: &lt;/b&gt;RL and QS for modules not APIs&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;b&gt;Policy Engine: &lt;/b&gt;Manage Accounts, Services, Region related policies.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;b&gt;Deployment Module: &lt;/b&gt;Help CI/CD and fast deployment&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;b&gt;Alert Rules: &lt;/b&gt;Alert Rules and error aggregation&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
