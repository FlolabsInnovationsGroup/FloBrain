# Server
PORT=3000

# Database — choose ONE line and make sure the DB exists (createdb file_uploads)
DATABASE_URL=postgresql://postgres:@localhost:5432/file_uploads
# Alternative format Sequelize also accepts:
# DATABASE_URL=postgres://postgres:@localhost:5432/file_uploads

# Upload limits
MAX_AUDIO_SIZE=5242880
MAX_VIDEO_SIZE=10485760
