{
  "compilerOptions": {
    "target": "es6",                          
    "module": "commonjs",                     
    "rootDir": "./",                       
    "outDir": "./dist",                       
    "strict": true,                           
    "esModuleInterop": true, 
    "allowJs": true,                 
    "skipLibCheck": true,                     
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],                    
  "exclude": ["node_modules"] 
}