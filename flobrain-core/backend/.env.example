# FloBrain backend (flobrain-core/backend) — environment variable reference.
#
# Copy this file to `.env` in this directory for local development and fill in
# real values there. `.env` is gitignored (see .gitignore) and must never be
# committed. This file must only ever contain variable NAMES and SAFE
# PLACEHOLDER values — no real secrets, tokens, passwords, or credentials.
#
# See flobrain/settings.py for how each variable is consumed.

# --- Core Django ---
# Required when DEBUG=False (production/staging/CI). The app refuses to start
# without this once DEBUG is False. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=changeme-generate-a-long-random-value

# "True" to enable Django debug mode. Must be "False" (or unset) outside local
# development. Defaults to False if unset.
DEBUG=False

# Comma-separated additional allowed Host headers (0.0.0.0/127.0.0.1/localhost
# are always included for local use). Set to the real ALB/CloudFront hostname(s)
# and/or custom domain in production.
ALLOWED_HOSTS=

# Comma-separated origins Django trusts for unsafe (POST/PUT/...) requests that
# carry the CSRF cookie, e.g. http://localhost:3000 for local Next.js dev.
# Do NOT put production frontend URLs here until they are confirmed - see the
# backend security report for the pending CORS/CSRF origin decision.
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Comma-separated browser origins allowed to call this API (CORS).
# Team-confirmed production value: https://flobrain.ai
# Do NOT add www/staging/other origins here without separate confirmation, and
# never add localhost to a production env file - local dev gets localhost
# automatically (only when DEBUG=True), see settings.py.
CORS_ALLOWED_ORIGINS=https://flobrain.ai

# --- AWS ALB / HTTPS (all default OFF — see settings.py comments) ---
# Only set these to "True" after DevOps has confirmed the ALB's forwarded-header
# behaviour and that the health check path is unaffected. See the backend
# security report "AWS ALB compatibility review" section.
TRUST_ALB_FORWARDED_PROTO=False
USE_X_FORWARDED_HOST=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Cookie security. Defaults to the opposite of DEBUG (secure when DEBUG=False),
# so these normally do not need to be set explicitly.
SESSION_COOKIE_SECURE=
CSRF_COOKIE_SECURE=

# --- Database ---
# "sqlite" for local/CI (no services needed); anything else uses PostgreSQL
# with the DB_* values below.
DB_ENGINE=postgresql
DB_NAME=flobrain_db
DB_USER=flo_user
DB_PASS=changeme-local-dev-password
DB_HOST=localhost
DB_PORT=5432

# --- Mongo (workflow/audit events) ---
MONGO_HOST=localhost
MONGO_PORT=27017

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Email (SMTP, used by contact and auth flows) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=changeme-smtp-password
SALES_EMAIL=

# --- Multimodal / LLM worker ---
MULTIMODAL_SERVICE_URL=http://localhost:8000
MULTIMODAL_API_KEY=changeme-multimodal-api-key
MULTIMODAL_SERVICE_TIMEOUT=60

# --- Memory subsystem ---
MEMORY_VECTOR_DB_PATH=./vector_db
MEMORY_VECTOR_COLLECTION=flobrain_memory_v1
MEMORY_EMBEDDING_FUNCTION=chromadb.utils.embedding_functions.DefaultEmbeddingFunction
MEMORY_RETRIEVAL_LIMIT=5
MEMORY_MIN_RELEVANCE=0.2
MEMORY_LEXICAL_CORPUS_LIMIT=500
MEMORY_CONTEXT_TOKEN_BUDGET=800
MEMORY_RECALL_ENABLED=True
MEMORY_AUTO_CAPTURE=
MEMORY_CAPTURE_MIN_CHARS=20
CHAT_HISTORY_TOKEN_BUDGET=6000
MEMORY_TOKENIZER=estimate
MEMORY_COLD_STORAGE_ENABLED=False
S3_VAULT_BUCKET=flobrain-cold-vault
AES_MASTER_KEY=changeme-64-hex-characters-required-only-if-cold-storage-enabled
