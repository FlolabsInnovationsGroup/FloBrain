# Optional when running Django outside Docker (venv on host).
# Prefer the root .env when using docker compose from the repo root.

DB_NAME=flobrain_db
DB_USER=flo_user
DB_PASS=flo_password
# Use "localhost" when Django runs on the host and Postgres is in Docker
# Use "db" when Django also runs inside Docker Compose
DB_HOST=localhost
DB_PORT=5432

MONGO_HOST=localhost
MONGO_PORT=27017
REDIS_URL=redis://localhost:6379/0

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SALES_EMAIL=
