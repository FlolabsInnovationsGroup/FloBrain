# FloBrain Alpha Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=FloBrain
DEBUG=false
HOST=0.0.0.0
PORT=8000

# LLM - Ollama (primary)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# LLM - OpenAI-compatible fallback (optional)
# OPENAI_COMPATIBLE_API_URL=https://api.openai.com/v1
# OPENAI_COMPATIBLE_API_KEY=sk-...

# Notion Integration
NOTION_TOKEN=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
NOTION_TASKS_DB_ID=b5a15559-fffc-4a4f-9716-1bf12e6fb400
NOTION_PROJECTS_DB_ID=ff260c53-55c3-4566-99d0-5e0bc1d4694a

# Notion OAuth (optional, for multi-user OAuth flow)
# NOTION_CLIENT_ID=your_notion_client_id
# NOTION_CLIENT_SECRET=your_notion_client_secret
# NOTION_REDIRECT_URI=http://localhost:8000/auth/notion/callback

# JWT Auth
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Database
SQLITE_URL=sqlite+aiosqlite:///./data/flobrain.db

# Vector Store (optional - ChromaDB)
CHROMADB_PATH=./data/chroma

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]
