# Test harness config — isolated DB + safer limits
PORT=4000
NODE_ENV=test

JWT_SECRET=change_me_test_secret
JWT_EXPIRES_IN=15m

DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=flolabs_test

UPLOAD_DIR=./storage/test_uploads
MAX_FILE_SIZE_MB=5
ALLOWED_MEDIA_TYPES=video/mp4,audio/mpeg,image/png

AI_SERVICE_BASE_URL=http://localhost:8081
AI_TASKS_ALLOWED=transcribe
AI_JOB_TIMEOUT_MS=30000
AI_MAX_RETRIES=1
AI_RETRY_BACKOFF_MS=250

LOG_LEVEL=warn
LOG_DEST=stdout
LOG_SAMPLING_DEBUG=false
REQUEST_ID_HEADER=x-request-id
ERROR_RESPONSE_INCLUDE_TRACE=false

AI_TEST_MODE=success
