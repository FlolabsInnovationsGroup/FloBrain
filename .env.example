# --- Logging Configuration ---
# The minimum level of logs to output.
# Recommended values: 'debug' for development, 'info' for production.
>>>>>>> origin/development
LOG_LEVEL=info

# --- AI Pipeline Configuration ---
# The base URL for the external AI service that this application calls.
# For local development, this might be a mock server.
AI_SERVICE_BASE_URL=http://localhost:4010

# A comma-separated list of the AI tasks that are allowed to run.
# The order does not matter. Possible values: transcription,summary,tags,embedding
AI_TASKS_ALLOWED=transcription,summary,tags,embedding

# The hard timeout in milliseconds for each individual AI job request to the external service.
AI_JOB_TIMEOUT_MS=60000

# The number of times to retry a failed job.
# For example, 2 means 1 initial attempt + 2 retries = 3 total attempts.
AI_MAX_RETRIES=2

# The fixed backoff time in milliseconds to wait between retry attempts.
AI_RETRY_BACKOFF_MS=1500