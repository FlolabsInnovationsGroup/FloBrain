# =============================================================================
# FloBrain local environment (copy to .env at repo root)
# Windows PowerShell:
#   Copy-Item .env.example .env
# =============================================================================

# --- Postgres (Django ORM) ---
POSTGRES_DB=flobrain_db
POSTGRES_USER=flo_user
POSTGRES_PASSWORD=flo_password

# --- Website (Next.js) ---
# Browser on your laptop talks to Django via the published host port
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional analytics / Sentry (leave blank for local)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
GA_MEASUREMENT_ID=

# --- FloBrain Cloud (FastAPI AI prototype on :8001) ---
# Not required for the website + Django path; fill in if you call cloud APIs
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# --- Optional Django / memory extras ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SALES_EMAIL=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_VAULT_BUCKET=flobrain-cold-vault
AES_MASTER_KEY=
