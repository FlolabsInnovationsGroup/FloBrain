# ── Server ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Auth ───────────────────────────────────────────────
JWT_SECRET=change_me_dev_secret
JWT_EXPIRES_IN=1h

# ── Database ───────────────────────────────────────────
# If DATABASE_URL is set, it overrides the discrete params below.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=flolabs_dev

# ── Uploads / Media ────────────────────────────────────
UPLOAD_DIR=./storage/uploads
MAX_FILE_SIZE_MB=50
ALLOWED_MEDIA_TYPES=video/mp4,audio/mpeg,image/png

# ── AI Orchestration ───────────────────────────────────
AI_SERVICE_BASE_URL=http://localhost:8080
AI_TASKS_ALLOWED=transcription,summary,tags,embedding
AI_JOB_TIMEOUT_MS=120000
AI_JOB_TIMEOUT_MS=120000
AI_MAX_RETRIES=3
AI_RETRY_BACKOFF_MS=1000

# ── Observability / Logging ────────────────────────────
LOG_LEVEL=info
LOG_DEST=stdout
LOG_SAMPLING_DEBUG=false
REQUEST_ID_HEADER=x-request-id
ERROR_RESPONSE_INCLUDE_TRACE=false
