cat > .env <<'ENV'
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://wardahassan@localhost:5432/file_uploads

# Media config
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=200
ALLOWED_AUDIO=audio/mpeg,audio/ogg,audio/wav
ALLOWED_VIDEO=video/mp4,video/quicktime,video/webm
ALLOWED_IMAGE=image/jpeg,image/png

# Dev auth stub (must exist in users table)
DEV_USER_ID=user_1
ENV
